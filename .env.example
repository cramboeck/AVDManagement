# ZeroStress Cockpit - Environment Variables
# Copy to .env.local for local development

# API Server
API_PORT=3001
API_URL=http://localhost:3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Database (Docker Compose defaults)
DATABASE_URL=postgresql://zerostress:dev_password_only@localhost:5432/zerostress

# Redis (Docker Compose defaults)
REDIS_URL=redis://localhost:6379

# Entra ID / Azure AD (App Registration)
# Create at: https://portal.azure.com > App Registrations
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret
ENTRA_TENANT_ID=your-partner-tenant-id

# Frontend Entra ID (same values, but NEXT_PUBLIC_ prefix for browser)
NEXT_PUBLIC_ENTRA_CLIENT_ID=your-client-id
NEXT_PUBLIC_ENTRA_TENANT_ID=your-partner-tenant-id

# Defender for Endpoint API (optional, EU data residency: https://api-eu.securitycenter.microsoft.com)
# DEFENDER_API_BASE_URL=https://api.securitycenter.microsoft.com

# AI explanations for CVEs (optional; feature stays hidden without it)
# ANTHROPIC_API_KEY=sk-ant-...
# NVD enrichment works without a key (rate limited); optional key from https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=

# Encryption key for personal job results (local admins etc.); 32 bytes base64: openssl rand -base64 32
# Without it, scripts flagged as personal refuse to store their output. Production: Key Vault.
# RESULT_ENCRYPTION_KEY=

# Alert mail (optional). Sender mailbox in YOUR partner tenant; needs Mail.Send application permission there.
# Without both values alerts stay in the console only.
# ALERT_MAIL_FROM=alerts@yourmsp.example
# ALERT_MAIL_TO=noc@yourmsp.example,you@yourmsp.example

# TeamViewer Web API script token (optional; needs "Devices: read"). Enables the Remote-Sitzung button.
# TEAMVIEWER_API_TOKEN=

# Artifact store for app packages (.intunewin, installers). local = folder on disk (dev), azure = Blob Storage EU via Managed Identity.
ARTIFACT_STORE=local
ARTIFACT_STORE_PATH=./data/artifacts
# ARTIFACT_AZURE_ACCOUNT=yourstorageaccount
# ARTIFACT_AZURE_CONTAINER=packages
# Registry prefix for PSADT detection keys (one per MSP, not per customer)
APP_DETECTION_PREFIX=ZSC
# Shared secret for the Windows build worker (openssl rand -base64 32); Key Vault in production
# WORKER_TOKEN=

# JWT Signing (generate with: openssl rand -base64 32)
JWT_SECRET=dev-secret-change-in-production

# Dev Auth Bypass (skip OAuth for local development)
DEV_AUTH_BYPASS=true
NEXT_PUBLIC_DEV_AUTH_BYPASS=true
