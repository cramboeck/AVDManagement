{
  "name": "zerostress-cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-Tenant SaaS Management Console for Microsoft Cloud",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "docker-compose up -d && npm run dev:all",
    "dev:all": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:ci": "npm run test:ci --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "db:push": "npm run db:push --workspace=@zerostress/api",
    "db:migrate": "npm run db:push --workspace=@zerostress/api",
    "db:studio": "npm run db:studio --workspace=@zerostress/api"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
